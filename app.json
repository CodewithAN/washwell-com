{
  "expo": {
    "name": "Wash Well",
    "slug": "Wash-Well",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CCF5F5"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBpuZ8ZSvz02H4--PECiKhyteW9qDhRly0"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CCF5F5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.artanistic.WashWell",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBpuZ8ZSvz02H4--PECiKhyteW9qDhRly0"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wash Well to use your location.(You can easily get laundry service on your address)"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a60b4c4b-b40a-438f-89ca-f5ce0428a2dd"
      }
    }
  }
}
